{
	"name": "ulivo",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev",
		"start": "dotenv -c -- turbo start",
		"lint": "biome check .",
		"format": "biome check --write .",
		"type-check": "turbo type-check",
		"test": "pnpm --filter @repo/payments test && pnpm --filter @repo/database test && pnpm --filter @repo/cooking test && pnpm --filter @repo/icons test && pnpm --filter @repo/api test",
		"icons:regenerate": "dotenv -c -- pnpm --filter @repo/icons regenerate",
		"seed:curated": "dotenv -c -- pnpm --filter @repo/database seed:curated",
		"recipes:backfill-step-ingredients": "dotenv -c -- pnpm --filter @repo/database backfill:step-ingredients",
		"clean": "turbo clean"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^26.6.6",
		"dotenv-cli": "^11.1.0",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	}
}
