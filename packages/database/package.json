{
	"name": "@repo/database",
	"version": "0.0.0",
	"private": true,
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"scripts": {
		"generate": "drizzle-kit generate --config drizzle/drizzle.config.ts",
		"seed:curated": "tsx seed/curated.ts",
		"backfill:step-ingredients": "tsx seed/backfill-step-ingredients.ts",
		"test": "tsx --test seed/recipes.test.ts",
		"migrate": "dotenv -c -e ../../.env -- drizzle-kit migrate --config drizzle/drizzle.config.ts",
		"push": "dotenv -c -e ../../.env -- drizzle-kit push --config drizzle/drizzle.config.ts",
		"studio": "dotenv -c -e ../../.env -- drizzle-kit studio --config drizzle/drizzle.config.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@repo/ai": "workspace:*",
		"@repo/cooking": "workspace:*",
		"@vercel/functions": "^3.10.5",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "26.6.6",
		"@types/pg": "^8.23.1",
		"dotenv-cli": "^11.1.0",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "7.0.2"
	}
}
