{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"AI_GATEWAY_API_KEY",
		"AI_GATEWAY_MODEL",
		"AI_GATEWAY_IMAGE_MODEL",
		"ICON_GENERATION_MODE",
		"VERCEL_OIDC_TOKEN",
		"NEXT_PUBLIC_APP_URL",
		"AWS_ENDPOINT_URL_S3",
		"AWS_ACCESS_KEY_ID",
		"AWS_SECRET_ACCESS_KEY",
		"AWS_REGION",
		"S3_BUCKET",
		"S3_PUBLIC_URL",
		"DODO_PAYMENTS_API_KEY",
		"DODO_PAYMENTS_WEBHOOK_SECRET",
		"DODO_PAYMENTS_ENVIRONMENT",
		"DODO_PAYMENTS_PRODUCT_ID",
		"ADMIN_EMAILS"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"type-check": {
			"dependsOn": ["^type-check"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"start": {
			"cache": false,
			"dependsOn": ["^build"],
			"persistent": true
		}
	}
}
