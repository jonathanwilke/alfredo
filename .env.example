# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon Postgres. Use the pooled connection for the app.
# Use the direct (non-pooler) connection for drizzle-kit migrations.
# Leave blank for typecheck and build. Set both in Vercel before running the app against a database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Google OAuth. Both values are required before Google sign-in is registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend. When RESEND_API_KEY is empty, development prints the magic link in the server log.
# EMAIL_FROM overrides the sender. The default is ulivo <noreply@ulivo.app>.
RESEND_API_KEY=
EMAIL_FROM=

# Vercel AI Gateway.
# Locally set AI_GATEWAY_API_KEY. On Vercel, VERCEL_OIDC_TOKEN is provided.
# AI_GATEWAY_MODEL is an optional provider/model id from https://ai-gateway.vercel.sh/v1/models
# When empty, extraction uses google/gemini-2.5-flash-lite.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# Image model for recipe and ingredient icons. Default is google/gemini-3.1-flash-image-preview.
AI_GATEWAY_IMAGE_MODEL=
# mock forces the local clay placeholder. live requires gateway credentials.
# When unset, missing gateway credentials use the mock.
ICON_GENERATION_MODE=
VERCEL_OIDC_TOKEN=

# Neon Object Storage (S3-compatible, branches with the database).
# `neon env pull` injects the AWS_* variables for the linked branch.
# Leave them blank for typecheck and build. Set them in Vercel before real uploads.
# Object storage is available in aws-us-east-1, aws-us-east-2, aws-eu-central-1, and aws-ap-southeast-1.
#
# AWS_ENDPOINT_URL_S3: branch S3 endpoint, for example https://<endpoint>.neon.tech
# AWS_ACCESS_KEY_ID: branch storage access key id
# AWS_SECRET_ACCESS_KEY: branch storage secret
# AWS_REGION: Neon region without the aws- prefix, for example us-east-2
# S3_BUCKET: bucket name on that branch. Use a public_read bucket so the browser can load icons.
# S3_PUBLIC_URL: optional CDN origin. When empty, the object URL is {AWS_ENDPOINT_URL_S3}/{S3_BUCKET}/{key}.
# When any required value is missing, icons are written under .data/icons and served from /icons.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PUBLIC_URL=

# Dodo Payments. Leave every value blank to run with billing disabled.
# Create one Pay What You Want one-time product. Pack prices live in
# packages/payments/config.ts. The server sends the amount at checkout.
# DODO_PAYMENTS_ENVIRONMENT must be test_mode or live_mode. Any other value disables billing.
# Checkout stays disabled until the API key, environment, and product id are set.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=
DODO_PAYMENTS_CREDITS_PRODUCT_ID=
