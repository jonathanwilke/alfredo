# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Neon Postgres. Use the pooled connection for the app.
# Use the direct (non-pooler) connection for drizzle-kit migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/alfredo?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/alfredo?sslmode=require

# Google OAuth. Both values are required before Google sign-in is registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway.
# Locally set AI_GATEWAY_API_KEY. On Vercel, VERCEL_OIDC_TOKEN is provided.
# AI_GATEWAY_MODEL is a provider/model id from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# Image model for recipe and ingredient icons. Default is google/gemini-3.1-flash-image-preview.
AI_GATEWAY_IMAGE_MODEL=
# mock forces the local clay placeholder. live requires gateway credentials.
# When unset, missing gateway credentials use the mock.
ICON_GENERATION_MODE=
VERCEL_OIDC_TOKEN=

# S3-compatible object storage for icons (Cloudflare R2, AWS S3, MinIO).
# When these are empty, icons are written under .data/icons and served from /icons.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=alfredo
S3_PUBLIC_URL=
